// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(uuid())
  username        String          @unique
  password        String
  avatars         Avatar[]
  avatarVideos    AvatarVideo[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Avatar {
  id              String                  @id @default(uuid())
  userId          String
  name            String
  avatarImages    AvatarImage[]
  avatarVideoRef  AvatarVideoReference[]
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

enum AvatarImageType {
  User
  Model
}

model AvatarImage {
  id              String           @id @default(uuid())
  avatarId        String
  type            AvatarImageType
  url             String
  avatar          Avatar           @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
}

enum AvatarVideoStatus {
  Pending
  Done
  Error
}

model AvatarVideo {
  id              String                  @id @default(uuid())
  userId          String
  prompt          String
  startFrame      String?
  endFrame        String?
  duration        Int
  width           Int
  height          Int
  status          AvatarVideoStatus       @default(Pending)
  avatarVideoRef  AvatarVideoReference[]
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model AvatarVideoReference {
  id              String      @id @default(uuid())
  avatarVideoId   String
  avatarId        String
  avatarVideo     AvatarVideo @relation(fields: [avatarVideoId], references: [id], onDelete: Cascade)
  avatar          Avatar      @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@unique([avatarVideoId, avatarId])
}